      "name": "00 Setup",
      "item": [
        {
          "name": "GET API Health Check",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\nconst timestamp = Date.now();\r\nconst randomFirstName = pm.variables.replaceIn(\"{{$randomFirstName}}\");\r\nconst orderId = Math.floor(Math.random() * 989) + 11;\r\nconst username = `qa_user_${timestamp}`;\r\n\r\npm.collectionVariables.set(\"petId\", timestamp);\r\npm.collectionVariables.set(\"petName\", `${randomFirstName} QA`);\r\npm.collectionVariables.set(\"updatedPetName\", `${randomFirstName} QA Updated`);\r\npm.collectionVariables.set(\"orderId\", orderId);\r\npm.collectionVariables.set(\"userId\", timestamp + 1);\r\npm.collectionVariables.set(\"username\", username);\r\npm.collectionVariables.set(\"updatedUsername\", `${username}_updated`);\r\npm.collectionVariables.set(\"userEmail\", `${username}@example.com`);\r\n\r\npm.test(\"Response time is less than 5000 ms\", function () {\r\n    pm.expect(pm.response.responseTime).to.be.below(5000);\r\n});\r\n\r\nconst contentType = pm.response.headers.get(\"Content-Type\");\r\n\r\npm.test(\"Content-Type header contains application/json\", function () {\r\n    pm.expect(contentType).to.include(\"application/json\");\r\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/openapi.json",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "openapi.json"
              ]
            }
          },
          "response": []
        }
      ]
    },
